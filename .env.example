# Copy to .env (git-ignored) and fill in. Read by docker-compose AND by the Python
# config loader; real environment variables take precedence over .env.

# Oracle (FREEPDB1). Passwords are applied only when the DB volume is first created;
# to rotate later use ALTER USER and then update this file.
ORACLE_SYS_PASSWORD=change_me
ORACLE_APP_USER=aml_owner
ORACLE_APP_PASSWORD=change_me

# Neo4j
NEO4J_PASSWORD=change_me

# Optional overrides of any config.yaml key, e.g.
# DB_BACKEND=oracle
# AML__DATA__PROFILE=dense
# AML__THRESHOLDS__LARGE_CASH_VND=300000000
